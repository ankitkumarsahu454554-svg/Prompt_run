{
  "name": "broke-but-functional",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:dups": "jscpd src --threshold 3",
    "check:knip": "knip",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run check:arch && npm run typecheck && npm run lint && npm run check-contrast && npm run check:traceability && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "clsx": "2.1.1",
    "lucide-react": "0.475.0",
    "next": "^15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.20",
    "axe-core": "4.10.2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "9.21.0",
    "eslint-config-next": "15.2.1",
    "fast-check": "3.23.2",
    "jscpd": "^5.4.1",
    "jsdom": "26.0.0",
    "knip": "^6.41.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "3.2.7"
  }
}

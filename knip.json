{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/layout.tsx",
    "src/app/loading.tsx",
    "src/app/not-found.tsx",
    "src/app/error.tsx",
    "src/domain/index.ts",
    "scripts/**/*.mjs",
    "playwright.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "ignoreDependencies": [
    "eslint",
    "eslint-config-next",
    "@typescript-eslint/*",
    "prettier"
  ]
}
